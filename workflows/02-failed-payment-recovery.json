      "id": "7c9e6b02-0001-4a3b-9c2d-000000000001",
      "name": "Failed Payment Webhook",
      "webhookId": "c41d7e6a-9b02-4f38-8a55-failed-payme"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Verify the payment provider's webhook signature before trusting a single field.\n// Requires NODE_FUNCTION_ALLOW_BUILTIN=crypto and N8N_BLOCK_ENV_ACCESS_IN_NODE=false\n// on the n8n container (both are set in infra/docker-compose.yml).\nconst crypto = require('crypto');\n\nconst secret = $env.PAYMENT_WEBHOOK_SECRET;\nif (!secret) {\n  throw new Error('PAYMENT_WEBHOOK_SECRET is not set on this n8n instance');\n}\n\nconst results = [];\n\nfor (const item of $input.all()) {\n  const headers = item.json.headers || {};\n  const signatureHeader = headers['x-provider-signature'] || headers['stripe-signature'] || '';\n\n  // The Webhook node runs with \"Raw Body\" on, so the exact bytes the provider\n  // signed are in binary.data - not in the parsed JSON body. Re-serialising the\n  // parsed body would change key order and break the HMAC.\n  const rawBody = item.binary && item.binary.data && item.binary.data.data\n    ? Buffer.from(item.binary.data.data, 'base64').toString('utf8')\n    : JSON.stringify(item.json.body || {});\n\n  // Header format: t=<unix seconds>,v1=<hex hmac of \"<t>.<rawBody>\">\n  const parts = {};\n  for (const pair of String(signatureHeader).split(',')) {\n    const [k, v] = pair.split('=');\n    if (k && v) parts[k.trim()] = v.trim();\n  }\n\n  if (!parts.t || !parts.v1) {\n    throw new Error('Missing or malformed signature header - request rejected');\n  }\n\n  const ageSeconds = Math.abs(Math.floor(Date.now() / 1000) - Number(parts.t));\n  if (ageSeconds > 300) {\n    throw new Error('Signature timestamp is ' + ageSeconds + 's old - replay rejected');\n  }\n\n  const expected = crypto\n    .createHmac('sha256', secret)\n    .update(parts.t + '.' + rawBody)\n    .digest('hex');\n\n  const a = Buffer.from(expected, 'utf8');\n  const b = Buffer.from(parts.v1, 'utf8');\n  if (a.length !== b.length || !crypto.timingSafeEqual(a, b)) {\n    throw new Error('Webhook signature did not match - request rejected');\n  }\n\n  const event = JSON.parse(rawBody);\n  const object = (event.data && event.data.object) || {};\n  const metadata = object.metadata || {};\n\n  const FAILURE_EVENTS = ['invoice.payment_failed', 'charge.failed', 'payment_intent.payment_failed'];\n  if (!FAILURE_EVENTS.includes(event.type)) {\n    throw new Error('Unexpected event type on the failed-payment webhook: ' + event.type);\n  }\n\n  const fullName = String(object.customer_name || metadata.student_name || '').trim();\n  const nameParts = fullName ? fullName.split(/\\s+/) : [];\n\n  results.push({\n    json: {\n      provider: $env.PAYMENT_PROVIDER_NAME || 'payment-provider',\n      event_id: event.id,\n      event_type: event.type,\n      email: String(object.customer_email || object.email || metadata.email || '')\n        .toLowerCase()\n        .trim(),\n      first_name: nameParts[0] || 'Student',\n      last_name: nameParts.slice(1).join(' ') || '-',\n      customer_id: object.customer || null,\n      invoice_id: object.invoice || object.id || null,\n      amount_cents: object.amount_total || object.amount_paid || object.amount_due || object.amount || null,\n      currency: object.currency || null,\n      course_id: metadata.course_id || $env.DEFAULT_COURSE_ID,\n      attempt_count: object.attempt_count || 1,\n      next_payment_attempt: object.next_payment_attempt || null,\n\n      raw: event,\n    },\n  });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
