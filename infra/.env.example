# -----------------------------------------------------------------------------
# cp .env.example .env  and fill in every value. Nothing here has a default.
# .env is gitignored. Keep the real one in your password manager as well, not
# only on the server.
# -----------------------------------------------------------------------------

# --- Host -------------------------------------------------------------------
# The public hostname n8n is served on. Caddy issues the certificate for this
# name, and n8n builds its public webhook URLs from it, so it must resolve to
# this server before you start the stack.
N8N_HOST=

# Address Let's Encrypt uses for expiry warnings.
LETSENCRYPT_EMAIL=

# IANA timezone for schedules, Wait nodes and the nightly reconciliation window.
# Use the business's timezone, not the server's: "yesterday" in UTC is not
# "yesterday" in Sydney, and a nightly job that gets that wrong reports garbage.
# e.g. Australia/Sydney
GENERIC_TIMEZONE=

# --- n8n secrets -------------------------------------------------------------
# Encrypts every stored credential. Generate once:  openssl rand -hex 32
# Lose it and the credentials in the database cannot be decrypted; change it
# and n8n will refuse to start against the existing database. Back it up.
N8N_ENCRYPTION_KEY=

# --- Postgres ---------------------------------------------------------------
# Superuser for the container. Used by n8n and by backup.sh / restore.sh.
POSTGRES_USER=
POSTGRES_PASSWORD=

# Database n8n uses for its own executions, credentials and workflow history.
POSTGRES_DB=n8n

# Separate database for the workflow tables in sql/schema.sql.
REVENUE_OPS_DB=revenue_ops

# --- Execution pruning ------------------------------------------------------
# Hours of execution data to keep. 336 = 14 days: long enough to debug a
# weekend incident on Monday, short enough that the tables stay small.
EXECUTIONS_DATA_MAX_AGE=336

# Hard ceiling on saved executions regardless of age. Whichever limit is hit
# first wins.
EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000

# --- Payment provider -------------------------------------------------------
# Short name recorded in processed_events.provider, so a second processor added
# later cannot collide with this one. e.g. stripe
PAYMENT_PROVIDER_NAME=

# API base the workflows call, with no trailing slash. e.g. https://api.<provider>.com/v1
PAYMENT_API_BASE=

# Signing secret for the webhook endpoint. The Code nodes in workflows 01 and 02
# recompute the HMAC with this and reject anything that does not match, so a
# wrong value here looks exactly like an attack: every delivery is rejected.
PAYMENT_WEBHOOK_SECRET=

# --- Thinkific --------------------------------------------------------------
# API base, no trailing slash. e.g. https://api.thinkific.com/api/public/v1
THINKIFIC_API_BASE=

# Password set on users the automation creates. They are expected to reset it
# through the normal flow; it should still be long and random.
THINKIFIC_TEMP_PASSWORD=

# Course the enrolment falls back to when the payment carries no
# metadata.course_id. Set it, or a mis-tagged payment silently enrols nobody.
DEFAULT_COURSE_ID=

# --- Transactional email ----------------------------------------------------
# Base URL of the sending API used by the dunning sequence, no trailing slash.
EMAIL_API_BASE=

# Where the dunning emails send a customer to fix their card.
BILLING_PORTAL_URL=

# --- Slack ------------------------------------------------------------------
# Channel names including the leading #. The Slack app needs chat:write and to
# be invited to both channels.
SLACK_ENROLMENTS_CHANNEL=#enrolments
SLACK_ALERTS_CHANNEL=#automation-alerts

# --- Backups ----------------------------------------------------------------
# Directory on the host for dated archives from backup.sh.
BACKUP_DIR=/var/backups/n8n

# Days of archives to keep locally before backup.sh deletes them. Push a copy
# off this machine too - a backup that only exists on the server it is backing
# up is not a backup.
BACKUP_RETENTION_DAYS=14
